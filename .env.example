# Copy to .env and fill in. NEVER commit .env. All keys stay server-side only.

# --- Agent server (/agent) ---
ANTHROPIC_API_KEY=          # Claude API key (or run `ant auth login` instead). The old name LLM_API_KEY still works
CMC_API_KEY=                # local-currency amounts on plans and the recipient page; the agent and web app read it
LIVING_BRAIN_API_KEY=       # the agent's memory; all three LIVING_BRAIN_* values are needed, or memory is off
LIVING_BRAIN_BRAIN_ID=
LIVING_BRAIN_SUBJECT_ID=     # UUID used as x-subject-id for this demo brain
COURNOT_API_URL=https://interface.cournot.ai
COURNOT_API_KEY=            # optional: the agent's depeg guard and make test-cournot need it once the free quota is used up
DEPEG_THRESHOLD_PCT=5      # test-cournot demo threshold in percent
AGENT_PRIVATE_KEY=          # agent role only: cannot withdraw or change rules. Create with `npm run key` in agent/
AGENT_HOST=                 # empty = 127.0.0.1: only this machine can reach the agent. A non-loopback value (e.g. 0.0.0.0) needs AGENT_API_TOKEN
AGENT_API_TOKEN=            # callers send `Authorization: Bearer <token>`. Server-to-server only: never put it in the browser
AGENT_DEMO_ATTACK=          # 1 = turn on the live demo's attack button (POST /plans/:id/demo-attack). It can only target the demo address, never a real recipient
PRIVY_APP_SECRET=
PRIVY_ACCESS_TOKEN=        # optional short-lived session from the LeashPay app for test-privy
NODEREAL_API_KEY=           # server only; also manages MegaFuel policies
MEGAFUEL_POLICY_ID=         # created separately; needs testnet funding

# --- Contract deployment (Builder A, local only) ---
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# --- Chain (BSC testnet, chain id 97) ---
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# The only address to configure: token, feed, T-bill, DEX and agent addresses
# are read on-chain from factory.config(), and each owner's vault from
# factory.vaultOf(owner). See docs/vault-abi.md.
FACTORY_ADDRESS=

# --- Atlas price relay (testnet only, run by Builder A) ---
# Reads the real Atlas feeds on BSC mainnet and mirrors them to the testnet relay.
BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org
REPORTER_PRIVATE_KEY=       # testnet relay key; must NEVER be the agent key

# --- Web (/web) ---  (NEXT_PUBLIC_* is exposed to the browser: no secrets here)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_FACTORY_ADDRESS=
