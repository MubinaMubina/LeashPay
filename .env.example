# Copy to .env and fill in. NEVER commit .env. All keys stay server-side only.

# --- Agent server (/agent) ---
LLM_API_KEY=
CMC_API_KEY=
LIVING_BRAIN_API_KEY=
COURNOT_API_URL=https://interface.cournot.ai
AGENT_PRIVATE_KEY=          # agent role only: cannot withdraw or change rules

# --- Chain (BSC testnet, chain id 97) ---
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# The only address to configure: token, feed, T-bill, DEX and agent addresses
# are read on-chain from factory.config(), and each owner's vault from
# factory.vaultOf(owner). See docs/vault-abi.md.
FACTORY_ADDRESS=

# --- Atlas price relay (testnet only, run by Builder A) ---
# Reads the real Atlas feeds on BSC mainnet and mirrors them to the testnet relay.
BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org
REPORTER_PRIVATE_KEY=       # testnet relay key; must NEVER be the agent key

# --- Web (/web) ---  (NEXT_PUBLIC_* is exposed to the browser: no secrets here)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_FACTORY_ADDRESS=
